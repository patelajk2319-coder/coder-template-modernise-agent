# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# Coder's LoadBalancer is internal-only (VPC-private) — reach it via the
# persistent port-forward coder-demo-eks's `task init` / `task port-forward` starts.
CODER_URL=http://localhost:8080

# Coder admin credentials — must match values set in coder-demo-eks/.env.
# Only used by task workspace/task logs (coder create / log streaming — no
# Terraform equivalent exists for either).
CODER_ADMIN_EMAIL=admin@coder.demo
CODER_ADMIN_PASSWORD=

# Long-lived API token for the coderd Terraform provider (task template).
# Auto-minted and auto-written to coder-demo-eks's own .env by that repo's
# `task init` (re-minted whenever the existing one stops authenticating,
# e.g. after a database reset) — copy the same value here manually, since
# this is a separate .env file `task init` doesn't touch. Used for two
# distinct purposes at push time: authenticating this Terraform push, and
# supplying the workspace template's AI Bridge (fake Anthropic) API key.
CODER_API_TOKEN=

WORKSPACE_REPO=https://github.com/patelajk2319-coder/coder-demo-modernise-flask

# Routes builds to a specific external provisioner (e.g. a team-owned
# cluster) instead of the control plane's built-in ones. Optional — leave
# blank to keep using the built-in provisioners.
PROVISIONER_TAG=

# Template governance metadata
TEMPLATE_OWNER=
TEMPLATE_COST_CENTRE=
TEMPLATE_TEAM=
TEMPLATE_ENV=

# Default autostop TTL for workspaces created from this template (e.g. 4h).
TEMPLATE_DEFAULT_TTL=4h

# Activity bump: extends the autostop deadline by this much on each detected
# session. Must be set explicitly — Coder defaults to 0 (off), which would
# stop an actively-used workspace right at TEMPLATE_DEFAULT_TTL.
TEMPLATE_ACTIVITY_BUMP=1h
